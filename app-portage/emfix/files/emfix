#!/usr/bin/env bash
# emfix: dry-run an emerge and print the config fixes Portage asks for
# as ready-to-paste commands. Nothing is changed on the system.
# Usage: emfix <same arguments you gave emerge>   e.g.  emfix -uDN @world
set -uo pipefail

EMFIX_VERSION=1.2
SOURCE_URL=https://raw.githubusercontent.com/onedayonokinawa/grimes-overlay/main/app-portage/emfix/files/emfix

echo "emfix $EMFIX_VERSION - work in progress tool, it can get things wrong. Check what it suggests before pasting."
echo

# Look up the newest emfix version at most once a day, in the background
# while emerge runs. Offline or no wget/curl just means no update notice.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/emfix/latest-version
fetch=
if [[ ! -f $cache || -n $(find "$cache" -mmin +1440 2>/dev/null) ]]; then
    (
        mkdir -p "${cache%/*}" 2>/dev/null || exit
        src=$(wget -qO- -T 3 -t 1 "$SOURCE_URL" 2>/dev/null || curl -fsS --max-time 3 "$SOURCE_URL" 2>/dev/null)
        v=$(sed -n 's/^EMFIX_VERSION=\([0-9.]*\)$/\1/p' <<< "$src")
        [[ -n $v ]] && echo "$v" > "$cache.tmp" && mv "$cache.tmp" "$cache"
    ) &
    fetch=$!
fi

update_notice() {
    [[ -n $fetch ]] && wait "$fetch" 2>/dev/null
    local latest
    latest=$(cat "$cache" 2>/dev/null) || return
    [[ $latest =~ ^[0-9.]+$ && $latest != "$EMFIX_VERSION" ]] || return
    [[ $(printf '%s\n' "$EMFIX_VERSION" "$latest" | sort -V | tail -1) == "$latest" ]] || return
    echo
    echo "*** A newer emfix is out (you have $EMFIX_VERSION, newest is $latest). Update it with:"
    echo "***   sudo emaint sync -r grimes-overlay && sudo emerge -av app-portage/emfix"
}
trap update_notice EXIT

if [[ $# -eq 0 ]]; then
    echo "Usage: emfix <emerge arguments>   e.g. emfix media-libs/libsfml"
    exit 1
fi

# Drop --ask/-a: this is only a dry run, there's nothing to say yes to
args=()
for a in "$@"; do
    case $a in
        --ask|--ask=*) ;;
        -[!-]*) a=${a//a/}; [[ $a != - ]] && args+=("$a") ;;
        *) args+=("$a") ;;
    esac
done

# --ask=n and --color=n override EMERGE_DEFAULT_OPTS so the output can be read
out=$(emerge -p --ask=n --color=n --autounmask=y --autounmask-continue=n "${args[@]}" 2>&1)
rc=$?

fixes=$(awk '
    /USE changes are necessary/         { dir = "package.use"; next }
    /keyword changes are necessary/     { dir = "package.accept_keywords"; next }
    /unmask changes are necessary/      { dir = "package.unmask"; next }
    /mask changes are necessary/        { dir = "package.unmask"; next }
    /license changes are necessary/     { dir = "package.license"; next }
    dir == ""                           { next }
    /^ *\(see / || /^#/                 { next }
    /^[[:space:]]*$/                    { if (seen) { dir = ""; seen = 0 }; next }
    /^[<>=~]*[a-z0-9-]+\/[^ ]+/ {
        seen = 1
        atom = $1
        name = atom
        sub(/^[<>=~]+/, "", name); sub(/:.*/, "", name)
        sub(/-[0-9][^\/]*$/, "", name); sub(/.*\//, "", name)
        printf "echo \"%s\" | sudo tee -a /etc/portage/%s/%s\n", $0, dir, name
    }
' <<< "$out")

# REQUIRED_USE: Portage won't choose flags for you here, so offer each choice
required=$(awk '
    function line(flags) {
        printf "  echo \"%s %s\" | sudo tee -a /etc/portage/package.use/%s\n", pkg, flags, name
    }
    function neg(f) { return f ~ /^!/ ? substr(f, 2) : "-" f }
    function pos(f) { return f ~ /^!/ ? "-" substr(f, 2) : f }
    /^- [a-z0-9-]+\/[^ ]+::/ {
        pkg = $2; sub(/::.*/, "", pkg); sub(/-[0-9][^\/]*$/, "", pkg)
        name = pkg; sub(/.*\//, "", name)
        delete on
        if (match($0, /USE="[^"]*"/)) {
            n = split(substr($0, RSTART + 5, RLENGTH - 6), u, " ")
            for (i = 1; i <= n; i++) {
                f = u[i]; gsub(/[()*%]/, "", f)
                if (f !~ /^-/) on[f] = 1
            }
        }
        next
    }
    /REQUIRED_USE flag constraints are unsatisfied/ { inreq = 1; next }
    inreq && /^[[:space:]]*$/ { inreq = 0; next }
    !inreq { next }
    {
        c = $0; sub(/^[[:space:]]+/, "", c)
        printf "%s needs: %s\n", pkg, c
        k = split(c, t, " ")
        if (k > 3 && t[1] ~ /^(exactly-one-of|any-of|at-most-one-of)$/ && t[2] == "(" && t[k] == ")" && c !~ /\?/) {
            cnt = 0
            for (i = 3; i < k; i++) if (on[t[i]]) cnt++
            if (cnt == 0 && t[1] != "at-most-one-of") {
                # none set: enable one of them
                for (i = 3; i < k; i++) line(pos(t[i]))
            } else {
                # too many set: keep one, turn the others off
                for (i = 3; i < k; i++) {
                    if (!on[t[i]]) continue
                    s = ""
                    for (j = 3; j < k; j++) if (j != i && on[t[j]]) s = s " " neg(t[j])
                    line(substr(s, 2))
                }
            }
        } else if (k == 4 && t[1] ~ /\?$/ && t[2] == "(" && t[4] == ")") {
            # "a? ( b )": turn b on, or turn a off
            a = t[1]; sub(/\?$/, "", a)
            line(pos(t[3])); line(neg(a))
        } else if (k == 1 && t[1] ~ /^!?[a-zA-Z0-9_+-]+$/) {
            line(pos(t[1]))
        } else {
            print "  (too complex to turn into a line: set the flags in /etc/portage/package.use/" name " yourself)"
        }
        print ""
    }
' <<< "$out")

if [[ -n $fixes ]]; then
    echo "Portage needs these config changes. Paste them, then run your emerge again:"
    echo
    echo "$fixes"
fi

if [[ -n $required ]]; then
    [[ -n $fixes ]] && echo
    echo "These packages need USE flags that Portage won't choose for you."
    echo "Pick ONE line for each package, paste it, then run your emerge again:"
    echo
    echo "$required"
    echo
    echo "If the same flag keeps coming up (like elogind on OpenRC), add it to USE= in"
    echo "/etc/portage/make.conf instead, then run: sudo emerge -avuDN @world"
fi

[[ -n $fixes || -n $required ]] && exit 0

if grep -q 'there are no ebuilds' <<< "$out"; then
    echo "Package not found. emerge says:"
    grep -E '^emerge: (there are no ebuilds|Maybe you meant)' <<< "$out" | sed 's/^emerge: /  /'
    exit 1
fi

if [[ $rc -eq 0 ]]; then
    echo "The dry run worked, so there's nothing in your config to fix."
    echo "If the real emerge failed while compiling, the error is in the build log Portage named, e.g.:"
    echo "  sudo tail -50 /var/tmp/portage/<category>/<package>/temp/build.log"
    exit 0
fi

# Blockers and slot conflicts: two packages (or two versions of one) that
# can't be installed together. Config lines can't fix these, so show the part
# of emerge's output that says who wants what. Portage wraps its blocker
# message, so match the pieces rather than the whole sentence.
conflict=$(awk '
    /^\[blocks / { print; next }
    /on the same system\.$|resulting in a slot conflict:$/ { grab = 1; next }
    /^For more information/ { grab = 0 }
    grab
' <<< "$out" | cat -s)

if [[ -n $conflict ]]; then
    echo "This is a dependency conflict: two packages (or two versions of one) can't be"
    echo "installed together. Config lines can't fix that. Here's what emerge says is"
    echo "pulling in each side:"
    echo
    head -50 <<< "$conflict"
    n=$(wc -l <<< "$conflict")
    (( n > 50 )) && echo "  ... ($((n - 50)) more lines, run: emerge -pv $*)"
    echo
    echo "Usually updating everything first sorts it out:"
    echo "  sudo emerge -avuDN @world"
    echo "then run your emerge again. If it still fails, send the output above to Claude."
    exit 1
fi

echo "No USE/keyword/mask/license fix found, and it isn't a conflict emfix recognises."
echo "Here's the end of what emerge said:"
echo
grep -v '^[[:space:]]*$' <<< "$out" | tail -25 | sed 's/^/  /'
exit 1
